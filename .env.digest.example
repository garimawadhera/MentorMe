NEWS_API_KEY=your_newsapi_key
ANTHROPIC_API_KEY=your_anthropic_api_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Comma-separated topics used to fetch relevant world headlines.
DIGEST_TOPICS=geopolitics,global economy,armed conflicts,international diplomacy

# Scheduler settings. The worker sends every day at DIGEST_HOUR:DIGEST_MINUTE in DIGEST_TIMEZONE.
DIGEST_TIMEZONE=UTC
DIGEST_HOUR=7
DIGEST_MINUTE=0

# Caps how many headlines are fetched per topic.
MAX_ARTICLES_PER_TOPIC=5

# Relative path to the subscriber list JSON file.
SUBSCRIBERS_FILE=digest_worker/data/subscribers.json
